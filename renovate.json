{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "automerge": true,
  "platformAutomerge": false,
  "packageRules": [
    {
      "description": "Keep coverage on Java 21 while ProGuard requires JMOD files",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepNames": [
        "java-jdk"
      ],
      "allowedVersions": "<22"
    }
  ]
}
