{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "automerge": true,
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "allowedVersions": "<22",
      "description": "Keep coverage on Java 21 while ProGuard requires JMOD files",
      "matchDepNames": [
        "java-jdk"
      ],
      "matchManagers": [
        "github-actions"
      ]
    }
  ],
  "platformAutomerge": false
}
